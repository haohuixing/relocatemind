# Runtime environment
APP_ENV="development"

# Supabase
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_COPIED_ANONYMOUS_API_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_COPIED_SERVICE_API_KEY"

# Session security
# Use a long, randomly generated value in .env and Render.
SECRET_KEY="replace-with-a-long-random-secret"

# Cookie/runtime settings
COOKIE_SECURE="false"
ANONYMOUS_COOKIE_MAX_AGE="3600"

# Optional AI configuration
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""